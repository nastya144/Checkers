{
    "WindowSize": {  // Настройки размера окна
        "Width": 0,  // Ширина окна (0 - автоопределение)
        "Hight": 0   // Высота окна (внимание: вероятно, ошибка, должно быть "Height")
    },
    "Bot": {  // Настройки бота
        "IsWhiteBot": false,  // Является ли белый игрок ботом (false - человек)
        "IsBlackBot": true,   // Является ли черный игрок ботом (true - бот)
        "WhiteBotLevel": 0,   // Уровень сложности бота для белых (0 - отключен)
        "BlackBotLevel": 5,   // Уровень сложности бота для черных (5 - высокий уровень)
        "BotScoringType": "NumberAndPotential",  // Метод оценки игры ботом
        "BotDelayMS": 0,  // Задержка перед ходом бота (в миллисекундах)
        "NoRandom": false,  // Использует ли бот случайность в принятии решений (false - есть случайность)
        "Optimization": "O1"  // Оптимизационный уровень бота (O1 - базовый)
    },
    "Game": {  // Общие параметры игры
        "MaxNumTurns": 120  // Максимальное количество ходов в игре
    }
}